<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../shared/identity.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>IosContentFilter</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Content Filter</ApplicationTitle>
    <ApplicationId>$(FilterHostBundleId)</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>

    <!-- Applied when signing is enabled. CI passes EnableCodeSigning=false. -->
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <ProvisioningType>manual</ProvisioningType>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#1F4E79" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#1F4E79" BaseSize="128,128" />
    <MauiAsset Include="../../shared/rules.sample.json" Link="Resources/Raw/rules.sample.json" LogicalName="rules.sample.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!--
    Include is the directory above the configuration folder.
    The appex path is Include/BuildOutput/Name.appex.
    scripts/build-extensions.sh stages that layout. Device builds only:
    content filters do not run in the Simulator, and CI compiles ios-arm64.
  -->
  <ItemGroup>
    <AdditionalAppExtensions Include="$(MSBuildThisFileDirectory)../../artifacts/appex/FilterData">
      <Name>FilterData</Name>
      <BuildOutput>Release-iphoneos</BuildOutput>
      <CodesignEntitlements>$(MSBuildThisFileDirectory)../../extensions/FilterExtensions/FilterData/FilterData.entitlements</CodesignEntitlements>
      <CodesignWarnIfNoEntitlements>false</CodesignWarnIfNoEntitlements>
    </AdditionalAppExtensions>
    <AdditionalAppExtensions Include="$(MSBuildThisFileDirectory)../../artifacts/appex/FilterControl">
      <Name>FilterControl</Name>
      <BuildOutput>Release-iphoneos</BuildOutput>
      <CodesignEntitlements>$(MSBuildThisFileDirectory)../../extensions/FilterExtensions/FilterControl/FilterControl.entitlements</CodesignEntitlements>
      <CodesignWarnIfNoEntitlements>false</CodesignWarnIfNoEntitlements>
    </AdditionalAppExtensions>
  </ItemGroup>

  <Target Name="StageFilterExtensions" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(SkipFilterExtensionBuild)' != 'true'">
    <Message Importance="high" Text="Building Swift filter extensions before the MAUI host." />
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../../scripts/build-extensions.sh&quot;" />
  </Target>

</Project>
